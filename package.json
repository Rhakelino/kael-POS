{
  "name": "pos-kaelcafe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"wrangler pages dev --port 8788\"",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "vite build && wrangler pages deploy dist --project-name kael-pos",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "better-sqlite3": "^13.0.2",
    "concurrently": "^10.0.4",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0",
    "wrangler": "^4.118.0"
  }
}
